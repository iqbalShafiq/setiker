## Copy this file to local.properties (gitignored) and fill in values.
## Android Studio usually writes sdk.dir automatically when you open the project.

# sdk.dir=C\:\\Users\\YOU\\AppData\\Local\\Android\\Sdk

# Google Sign-In — Web application OAuth client ID from Google Cloud Console.
# Used as Credential Manager serverClientId / ID token audience on the device.
# Must also be listed in the API env GOOGLE_CLIENT_IDS (see stiker-api .env.example).
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# --- iOS (configure in iosApp/iosApp/Info.plist, not local.properties) ---
# GIDClientID=your-ios-client-id.apps.googleusercontent.com
# GIDServerClientID=your-web-client-id.apps.googleusercontent.com   # same as GOOGLE_WEB_CLIENT_ID
# CFBundleURLSchemes=com.googleusercontent.apps.YOUR_REVERSED_IOS_CLIENT_ID
#   (reversed client ID: take the iOS client id before ".apps.googleusercontent.com")
